{
  "name": "moneygen",
  "version": "1.7.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk-debug": "eas build --platform android --profile apk-debug",
    "build:apk-release": "cd android && gradlew.bat assembleRelease && cd ..",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "build:local": "eas build --platform android --profile preview --local",
    "build:local-apk": "call scripts\\build-apk.bat",
    "prebuild": "npx expo prebuild --platform android",
    "check-build": "node scripts/check-build-config.js",
    "check-assistant": "node --experimental-default-type=module --import ./scripts/register-resolver.mjs scripts/check-assistant.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ui": "maestro test .maestro",
    "test:ui:studio": "maestro studio"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^14.0.1",
    "babel-preset-expo": "^54.0.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18"
  },
  "resolutions": {
    "glob": "^7.1.6"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "components/**/*.js",
      "database/**/*.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
